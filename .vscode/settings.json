{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "[c]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
  },
  "[makefile]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "tooark.ark-format-makefile",
  },
  "[json]": {
    "editor.formatOnSave": true
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.default.compileCommands": [
    "${workspaceFolder}/compile_commands.json"
  ],
  "clangd.path": "clangd-22",
  "color-picker-universal.customRegexes": {
    "rgb": [
      {
        "regex": "\\{\\s*([0-9]{1,3})\\s*,\\s*([0-9]{1,3})\\s*,\\s*([0-9]{1,3})\\s*\\}\\s*/\\*RGB\\*/",
        "languages": [
          "c"
        ]
      }
    ]
  },
  "color-picker-universal.customOutputs": {
    "rgb": [
      {
        "files": [
          "c"
        ],
        "template": "{{{r}}, {{g}}, {{b}}} /*RGB*/",
        "values": {
          "r": {
            "from": 0,
            "to": 255,
            "maxDigits": 0
          },
          "g": {
            "from": 0,
            "to": 255,
            "maxDigits": 0
          },
          "b": {
            "from": 0,
            "to": 255,
            "maxDigits": 0
          }
        }
      }
    ]
  },
  "maptz.regionfolder": {
    "[c]": {
      "foldEndRegex": "^#pragma endregion$",
      "foldStartRegex": "^#pragma region.*$",
    },
  },
  "files.associations": {
    "*.h": "c"
  },
  "makefile.configureOnOpen": false
}
