{
    "[c]": {
        // "editor.formatOnSave": true,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    },
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.default.compileCommands": [
        "${workspaceFolder}/compile_commands.json"
    ],
    // "C_Cpp.default.includePath": [
    //     "${workspaceFolder}/*",
    //     "${workspaceFolder}/**"
    // ],
    "color-picker-universal.customRegexes": {
        "rgb": [
        {
            "regex": "\\{\\s*([0-9]{1,3})\\s*,\\s*([0-9]{1,3})\\s*,\\s*([0-9]{1,3})\\s*\\}\\s*/\\*RGB\\*/",
            "languages": ["c", "cpp"]
        }
        ]
    },
    "color-picker-universal.customOutputs": {
        "rgb": [
        {
            "files": ["c", "cpp"],
            "template": "{{{r}}, {{g}}, {{b}}} /*RGB*/",
            "values": {
            "r": { "from": 0, "to": 255, "maxDigits": 0 },
            "g": { "from": 0, "to": 255, "maxDigits": 0 },
            "b": { "from": 0, "to": 255, "maxDigits": 0 }
            }
        }
        ]
    },
    "makefile.configureOnOpen": false
}
